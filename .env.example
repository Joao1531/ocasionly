# --- Text + vision model: opencode Go (OpenAI-compatible API) ---
# Key from https://opencode.ai (console > API key). GLM 5.3 Flash accepts images,
# so it covers both the styling advice and the analysis of garment photos.
# Everything below can also be set (and tested) on the "Models" screen in the app.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# Leave empty to stop the model from seeing photos (it then uses the written data only).
LLM_VISION_MODEL=glm-5.3-flash

# --- Fitting room (optional) ---
# Needs a model with IMAGE OUTPUT. opencode has none (text/vision only), so the fitting room uses Gemini
# (free key at https://aistudio.google.com/apikey; image models may require billing).
GEMINI_API_KEY=
TRYON_MODEL=gemini-2.5-flash-image
