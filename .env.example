# --- Modelo de texto + visão: opencode Go (API compatível com OpenAI) ---
# Chave em https://opencode.ai (consola > API key). O GLM 5.3 Flash aceita imagens,
# por isso serve para os conselhos e para analisar as fotos das peças.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
# Deixa vazio para desativar o preenchimento automático a partir da foto.
LLM_VISION_MODEL=glm-5.3-flash

# --- Provador virtual (opcional) ---
# O opencode Go não gera imagens, por isso o provador usa o Gemini
# (chave grátis em https://aistudio.google.com/apikey; os modelos de imagem podem exigir faturação).
# O opencode não tem modelos de imagem (só texto/visão). Podes mudar tudo isto em ⚙ Modelos na app.
GEMINI_API_KEY=
TRYON_MODEL=gemini-2.5-flash-image
